# Default local development database
DATABASE_BACKEND=sqlite
SQLITE_FILE_NAME=aurorah.db

# Azure SQL Server (set DATABASE_BACKEND=sqlserver to use these values)
DATABASE_AUTO_CREATE_SCHEMA=false
MSSQL_SERVER=
MSSQL_DATABASE=
MSSQL_USERNAME=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# Firebase Admin SDK; keep the service-account JSON outside this repository.
# In production, prefer the hosting platform's attached service identity.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
